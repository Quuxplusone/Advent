;
;>>	FILE:	ADVBLD.ODL
;		28-OCT-80
;
;>>	ADVENTURES PROGRAM OVERLAY DESCRIPTION
;
;    PASCAL SUPPORT MODULES OVERLAY DESCRIPTION:
@ADVPAS.ODL
;
;    ROOT OVERLAY SEGMENT DEFINITION:
;
;	Uncomment the following root definition and delete the other if you
;	don't have a resident runtime system library.  Also uncomment the
;	SYSIO definition in ADVPAS.
;.ROOT	SINGLE,SYSIO,ADVSUB,*MAIN
;
.ROOT SINGLE,ADVSUB,*MAIN
;
;    SUBROUTINES CO-TREE DEFINITION:
;
ADVSUB:	.FCTR ADV/LB:SUBS0-*(S1,ADV/LB:DUMPWD,ADV/LB:SUBS1)
S1:	.FCTR ADV/LB:RDWIZ-(S2,S3)
S2:	.FCTR ADV/LB:FINISH-(S4,ADV/LB:CALSCO)
S3:	.FCTR ADV/LB:HOURS-(ADV/LB:DATIME,ADV/LB:PRIMET)
S4:	.FCTR ADV/LB:ASK-(ADV/LB:WIZMAG,ADV/LB:SPEAK,ADV/LB:GETIN)
;
;    MAIN PROGRAM TREE DEFINITION
;
MAIN:	.FCTR ADV/LB:MAIN-*LOOP
LOOP:	.FCTR (L1,L2,L3,ADVRSP)
ADVRSP:	.FCTR ADV/LB:RESPON-(R1,R2,ADVACT)
ADVACT:	.FCTR ADV/LB:PARSE-A1
;
;  MAIN LOOP OVERLAY DESCRIPTION
;
L1:	.FCTR ADV/LB:ADVINI
L2:	.FCTR ADV/LB:LOOP0 
L3:	.FCTR ADV/LB:START
;
;  RESPONSE SUB-LOOP OVERLAY DESCRIPTION
;
R1:	.FCTR ADV/LB:LOOP1 
R2:	.FCTR ADV/LB:MAGICM 
;
;  PARSE SUB-LOOP OVERLAY DESCRIPTION
;
A1:	.FCTR (A2,ADV/LB:VERBS5,A9)
A2:	.FCTR ADV/LB:TRANSI-(A3,A4,A5,A6)
A3:	.FCTR (ADV/LB:VERBS0,ADV/LB:VERBS1,ADV/LB:VERBS2) 
A4:	.FCTR ADV/LB:SAYIT-(ADV/LB:MAGICW,A7) 
A5:	.FCTR ADV/LB:TAKE-(ADV/LB:FILLIT,ADV/LB:GETIT)
A6:	.FCTR ADV/LB:THROWO-(ADV/LB:VERBS3,ADV/LB:DROPOB,ADV/LB:KILLIT)
A7:	.FCTR ADV/LB:TRAVEL-(ADV/LB:BACKUP,ADV/LB:NOWAY,A8)
A8:	.FCTR (ADV/LB:PLOVER,ADV/LB:TROLLB)
A9:	.FCTR ADV/LB:VERBS4-(ADV/LB:SAVNAM,ADV/LB:SAVVAR)
.END
