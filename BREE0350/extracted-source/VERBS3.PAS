{  *************** DATA STRUCTURE ROUTINES  ******************  }

PROCEDURE DROP(OBJ,WHERE:INTEGER);EXTERNAL;

PROCEDURE DESTROY(OBJ:INTEGER);EXTERNAL;

FUNCTION TOTING(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION HERE(OBJ:INTEGER):BOOLEAN;EXTERNAL;

PROCEDURE MOVE(OBJ,WHERE:INTEGER);EXTERNAL;

PROCEDURE JUGGLE(OBJ:INTEGER);EXTERNAL;

FUNCTION AT(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION RAN(RANGE:INTEGER):INTEGER;EXTERNAL;

{ *************  I/O  SUBROUTINES   ********************}

PROCEDURE RSPEAK(MSG:INTEGER);EXTERNAL;

{ ******************* VERB FEED ******************* }

{ "feed" -- If bird, no seed.  Snake, dragon, troll: quip.  If dwarf, make him
mad.  Bear, special.  }
PROCEDURE FEEDIT;
BEGIN
    CASE OBJ OF
	BIRD: RSPEAK(100);
	TROLL: RSPEAK(182);
	DRAGON: IF PROP[DRAGON]<>0 THEN RSPEAK(110) ELSE RSPEAK(102);
	SNAKE: IF CLOSED OR NOT HERE(BIRD) THEN RSPEAK(102) ELSE BEGIN
	    IF TOTING(BIRD) THEN DROP(BIRD,LOCATION);
	    DESTROY(BIRD);
	    PROP[BIRD]:=0;
	    TALLY2:=TALLY2+1;
	    RSPEAK(101)
	END;
	DWARF: IF NOT HERE(FOOD) THEN RSPEAK(ACTSPK[VERB]) ELSE BEGIN
	    DFLAG:=DFLAG+1;
	    RSPEAK(103)
	END;
	BEAR: IF NOT HERE(FOOD) THEN IF PROP[BEAR]=0 THEN RSPEAK(102)
	ELSE IF PROP[BEAR]=3 THEN RSPEAK(110) ELSE RSPEAK(ACTSPK[VERB])
	ELSE BEGIN
	    IF TOTING(FOOD) THEN DROP(FOOD,LOCATION);
	    DESTROY(FOOD);
	    PROP[BEAR]:=1;
	    FIXED[AXE]:=0;
	    PROP[AXE]:=0;
	    RSPEAK(168)
	END;
	ELSE RSPEAK(14)

    END
END;

{ *************** TROLL TREASURE PROCEDURE ****************** }

PROCEDURE SNARF;
BEGIN
    { Snarf a treasure for the troll.  }
    DROP(OBJ,0);
    DESTROY(TROLL);
    DESTROY(TROLL+100);
    MOVE(TROLL2,PLACE1[TROLL]);
    MOVE(TROLL2+100,FIXED1[TROLL]);
    JUGGLE(CHASM);
    RSPEAK(159)
END;

{ ****************** VERB THROW (OBJ=AXE) ****************** }

{  Good grief! He's thrown his axe. What is he trying to kill?  }
PROCEDURE THROWAXE;
VAR I:INTEGER;
BEGIN
    FOR I:=1 TO 5 DO IF DLOC[I]=LOCATION THEN BEGIN
	{ He attacks a little dwarf! }
	IF RAN(3)=1 THEN RSPEAK(48) ELSE BEGIN
	    DSEEN[I]:=FALSE;
	    DLOC[I]:=0;
	    DKILL:=DKILL+1;
	    IF DKILL=1 THEN RSPEAK(149) ELSE RSPEAK(47)
	END;
	DROP(AXE,LOCATION);
	NEWLOC:=LOCATION;
	MOVED:=TRUE;
	I:=5
    END;
    IF NOT MOVED THEN IF AT(DRAGON) AND(PROP[DRAGON]=0) THEN BEGIN
	RSPEAK(152);
	DROP(AXE,LOCATION);
	NEWLOC:=LOCATION;
	MOVED:=TRUE
    END ELSE IF AT(TROLL) THEN BEGIN
	RSPEAK(158);
	DROP(AXE,LOCATION);
	NEWLOC:=LOCATION;
	MOVED:=TRUE
    END ELSE IF HERE(BEAR) AND(PROP[BEAR]=0) THEN BEGIN
	{  This'll teach him to throw the axe at the bear! }
	DROP(AXE,LOCATION);
	FIXED[AXE]:=-1;
	PROP[AXE]:=1;
	JUGGLE(BEAR);
	RSPEAK(164)
    END ELSE OBJ:=0
END;

