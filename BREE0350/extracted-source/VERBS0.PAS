{$C	.TITLE	VERBS0
	.IDENT  /V0/    }

{  *************** DATA STRUCTURE ROUTINES  ******************  }

FUNCTION TOTING(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION AT(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION LIQ:INTEGER;EXTERNAL;

FUNCTION LIQLOC(LOC:INTEGER):INTEGER;EXTERNAL;

PROCEDURE DROP(OBJ,WHERE:INTEGER);EXTERNAL;

FUNCTION HERE(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION DARK:BOOLEAN;EXTERNAL;

{ *************  I/O  SUBROUTINES   ********************}

PROCEDURE RSPEAK(MSG:INTEGER);EXTERNAL;

PROCEDURE PSPEAK(OBJ,PROP:INTEGER);EXTERNAL;

{*********************  VERB FIND  *****************************}

{ "find" -- Might be carrying it, might be here.  }
PROCEDURE FINDIT;
VAR	X:BOOLEAN;
	I:INTEGER;
BEGIN
	IF TOTING(OBJ) THEN RSPEAK(24)
	ELSE IF CLOSED THEN RSPEAK(138)
	ELSE BEGIN
		X:=FALSE;
		IF OBJ=DWARF THEN
		FOR I:=1 TO 5 DO
		IF (DLOC[I]=LOCATION)AND(DFLAG>=2) THEN X:=TRUE;
		IF AT(OBJ)OR((LIQ=OBJ)AND AT(BOTTLE))OR(K=LIQLOC(LOCATION))
		OR X THEN RSPEAK(94)
		ELSE RSPEAK(ACTSPK[VERB])
	END
END;

{ ******************* VERB BREAK ****************** }

PROCEDURE WAKEDWARVES;EXTERNAL;

{ "break" -- Only works for mirror in repository and, of course, the vase.  }
PROCEDURE BREAKIT;
BEGIN
	CASE OBJ OF
		MIRROR: IF CLOSED THEN BEGIN
			RSPEAK(197);
			WAKEDWARVES
		END

		ELSE RSPEAK(148);
		VASE: IF PROP[VASE]=0 THEN BEGIN
			IF TOTING(VASE) THEN DROP(VASE,LOCATION);
			PROP[VASE]:=2;
			FIXED[VASE]:=-1;
			RSPEAK(198)
		END
		ELSE RSPEAK(ACTSPK[VERB]);
		ELSE RSPEAK(ACTSPK[VERB])
	END
END;

{******************  LAMP ON PROCEDURE  *********************}

{  Light the lamp...  }
PROCEDURE LAMPON;
BEGIN
    IF NOT HERE(LAMP) THEN RSPEAK(ACTSPK[VERB])
    ELSE IF LIMIT<0 THEN RSPEAK(184)
    ELSE IF PROP[LAMP]=1 THEN RSPEAK(204)
    ELSE BEGIN
	PROP[LAMP]:=1;
	RSPEAK(39);
	IF WZDARK THEN BEGIN
	    MOVED:=TRUE;
	    NEWLOC:=LOCATION
	END
    END
END;

{*****************  LAMP OFF PROCEDURE  *******************}

PROCEDURE LAMPOFF;
BEGIN
    IF NOT HERE(LAMP) THEN RSPEAK(ACTSPK[VERB])
    ELSE BEGIN
	IF PROP[LAMP]=0 THEN RSPEAK(205)
	ELSE BEGIN
	    PROP[LAMP]:=0;
	    RSPEAK(40)
	END;
	IF DARK THEN RSPEAK(16)
    END
END;

{******************** VERB WAVE *****************************}

{ "wave" -- No effect unless waving rod at fissure.  }
PROCEDURE WAVEIT;
BEGIN
    IF (NOT TOTING(OBJ))AND((OBJ<>ROD)OR NOT TOTING(ROD2)) THEN RSPEAK(29)
    ELSE IF CLOSING OR NOT AT(FISSURE) THEN RSPEAK(ACTSPK[VERB])
    ELSE BEGIN
	PROP[FISSURE]:=1-PROP[FISSURE];
	PSPEAK(FISSURE,2-PROP[FISSURE])
    END
END;

