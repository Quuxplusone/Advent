		23-SEP-80

		This module contains the procedure FILLIT.

********>>>>>>>><<<<<<<<********}


{$C	.TITLE	FILLIT
	.IDENT	/V0/	 }

{  *************** DATA STRUCTURE ROUTINES  ******************  }

PROCEDURE MOVE(OBJ,WHERE:INTEGER);EXTERNAL;

PROCEDURE DROP(OBJ,WHERE:INTEGER);EXTERNAL;

PROCEDURE JUGGLE(OBJ:INTEGER);EXTERNAL;

FUNCTION TOTING(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION HERE(OBJ:INTEGER):BOOLEAN;EXTERNAL;

FUNCTION LIQ:INTEGER;EXTERNAL;

FUNCTION LIQLOC(LOC:INTEGER):INTEGER;EXTERNAL;

{ *************  I/O  SUBROUTINES   ********************}

PROCEDURE RSPEAK(MSG:INTEGER);EXTERNAL;

PROCEDURE PSPEAK(OBJ,PROP:INTEGER);EXTERNAL;

{ ************************ VERB FILL ************************ }

PROCEDURE VERBHUH;EXTERNAL;

{ "fill" -- Bottle must be empty, and some liquid available.  (Vase is nasty.)}
PROCEDURE FILLIT;
BEGIN
	IF OBJ=VASE THEN BEGIN
		IF LIQLOC(LOCATION)=0 THEN RSPEAK(144)
		ELSE IF NOT TOTING(VASE) THEN RSPEAK(29)
		ELSE BEGIN
			RSPEAK(145);
			PROP[VASE]:=2;
			FIXED[VASE]:=-1;
			PSPEAK(VASE,3);
			DROP(VASE,LOCATION)
		END
	END
	ELSE IF (OBJ<>0)AND(OBJ<>BOTTLE) THEN RSPEAK(ACTSPK[VERB])
	ELSE IF (OBJ=0)AND NOT HERE(BOTTLE) THEN VERBHUH
	ELSE IF LIQLOC(LOCATION)=0 THEN RSPEAK(106)
	ELSE IF LIQ<>0 THEN RSPEAK(105)
	ELSE BEGIN
		PROP[BOTTLE]:=2*((CONDI[LOCATION] MOD 4) DIV 2);
		IF TOTING(BOTTLE) THEN MOVE(LIQ,-1);
		JUGGLE(BOTTLE);
		IF LIQ=OIL THEN RSPEAK(108) ELSE RSPEAK(107)
	END
END;

